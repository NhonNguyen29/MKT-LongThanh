{
  "name": "saoviet-marketing-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "node scripts/test-api.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate": "node --env-file=.env.production.local --import tsx scripts/migrate-production.ts",
    "db:import": "node --env-file=.env.production.local --import tsx scripts/import-production.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
